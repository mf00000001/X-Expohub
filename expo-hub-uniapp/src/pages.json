{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "@/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "ExpoHub 展会通",
        "navigationStyle": "custom",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/exhibition/list",
      "style": {
        "navigationBarTitleText": "展会列表",
        "enablePullDownRefresh": true,
        "onReachBottomDistance": 50
      }
    },
    {
      "path": "pages/exhibition/detail",
      "style": {
        "navigationBarTitleText": "展会详情",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/booth/detail",
      "style": {
        "navigationBarTitleText": "展位详情"
      }
    },
    {
      "path": "pages/product/list",
      "style": {
        "navigationBarTitleText": "展品列表",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/product/detail",
      "style": {
        "navigationBarTitleText": "展品详情"
      }
    },
    {
      "path": "pages/procurement/list",
      "style": {
        "navigationBarTitleText": "采购需求",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/procurement/detail",
      "style": {
        "navigationBarTitleText": "采购需求详情"
      }
    },
    {
      "path": "pages/message/list",
      "style": {
        "navigationBarTitleText": "消息中心"
      }
    },
    {
      "path": "pages/message/conversation",
      "style": {
        "navigationBarTitleText": "会话详情"
      }
    },
    {
      "path": "pages/user/login",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/user/register",
      "style": {
        "navigationBarTitleText": "注册",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/user/profile",
      "style": {
        "navigationBarTitleText": "个人主页",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/user/settings",
      "style": {
        "navigationBarTitleText": "设置"
      }
    },
    {
      "path": "pages/search/index",
      "style": {
        "navigationBarTitleText": "搜索",
        "navigationStyle": "custom"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages_visitor",
      "pages": [
        {
          "path": "my_registrations",
          "style": { "navigationBarTitleText": "我的报名/收藏" }
        },
        {
          "path": "my_procurements",
          "style": { "navigationBarTitleText": "我的采购需求" }
        },
        {
          "path": "procurement_create",
          "style": { "navigationBarTitleText": "发布采购需求" }
        }
      ]
    },
    {
      "root": "pages_buyer",
      "pages": [
        {
          "path": "dashboard",
          "style": {
            "navigationBarTitleText": "买家中心",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "my_registrations",
          "style": { "navigationBarTitleText": "我报名的展会" }
        },
        {
          "path": "my_procurements",
          "style": { "navigationBarTitleText": "我的采购需求" }
        },
        {
          "path": "procurement_create",
          "style": { "navigationBarTitleText": "发布采购需求" }
        }
      ]
    },
    {
      "root": "pages_exhibitor",
      "pages": [
        {
          "path": "dashboard",
          "style": {
            "navigationBarTitleText": "展商工作台",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "my_booths",
          "style": { "navigationBarTitleText": "我的展位" }
        },
        {
          "path": "my_products",
          "style": { "navigationBarTitleText": "我的展品" }
        },
        {
          "path": "product_create",
          "style": { "navigationBarTitleText": "添加展品" }
        },
        {
          "path": "product_edit",
          "style": { "navigationBarTitleText": "编辑展品" }
        },
        {
          "path": "procurement_matches",
          "style": { "navigationBarTitleText": "采购匹配" }
        }
      ]
    },
    {
      "root": "pages_organizer",
      "pages": [
        {
          "path": "dashboard",
          "style": {
            "navigationBarTitleText": "主办方工作台",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "exhibition_list",
          "style": {
            "navigationBarTitleText": "我的展会",
            "enablePullDownRefresh": true
          }
        },
        {
          "path": "exhibition_create",
          "style": { "navigationBarTitleText": "创建展会" }
        },
        {
          "path": "exhibition_edit",
          "style": { "navigationBarTitleText": "编辑展会" }
        },
        {
          "path": "booth_layout",
          "style": { "navigationBarTitleText": "展位布局" }
        },
        {
          "path": "booth_create",
          "style": { "navigationBarTitleText": "创建展位" }
        },
        {
          "path": "booth_assign",
          "style": { "navigationBarTitleText": "分配展位" }
        },
        {
          "path": "registrations",
          "style": { "navigationBarTitleText": "报名管理" }
        },
        {
          "path": "statistics",
          "style": { "navigationBarTitleText": "数据统计" }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["pages_visitor", "pages_buyer", "pages_exhibitor"]
    },
    "pages_organizer/dashboard": {
      "network": "all",
      "packages": ["pages_organizer"]
    }
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#3B82F6",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "iconPath": "static/icons/tab_home.png",
        "selectedIconPath": "static/icons/tab_home_active.png",
        "text": "首页"
      },
      {
        "pagePath": "pages/exhibition/list",
        "iconPath": "static/icons/tab_exhibition.png",
        "selectedIconPath": "static/icons/tab_exhibition_active.png",
        "text": "展会"
      },
      {
        "pagePath": "pages/message/list",
        "iconPath": "static/icons/tab_message.png",
        "selectedIconPath": "static/icons/tab_message_active.png",
        "text": "消息"
      },
      {
        "pagePath": "pages/user/profile",
        "iconPath": "static/icons/tab_profile.png",
        "selectedIconPath": "static/icons/tab_profile_active.png",
        "text": "我的"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "ExpoHub",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f5f7fa"
  }
}
