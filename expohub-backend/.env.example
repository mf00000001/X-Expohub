# ExpoHub 环境配置模板
# 复制为 .env 后使用

APP_NAME=ExpoHub API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8002

DATABASE_URL=sqlite:///./expohub.db

SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["*"]
